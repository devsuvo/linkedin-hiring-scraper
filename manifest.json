{
  "manifest_version": 3,
  "name": "Hiring Post Collector",
  "version": "1.1.0",
  "description": "Scroll korar somoy 'We are hiring' / hiring post gulu link soho copy kore Word file e save kore.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Hiring Post Collector" }
}
